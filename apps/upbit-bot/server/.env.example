# ===== 업비트 자동매매 봇 — 내 PC 전용 설정 파일 =====
# 이 파일(.env)에는 본인의 API 키가 들어갑니다. 다른 사람에게 보내거나 인터넷에 올리지 마세요.
# 한 줄에 "이름=값" 형식으로 적습니다. 값 앞뒤에 공백·따옴표를 넣지 않아도 됩니다.

# --- 업비트 Open API 키 ---
# 업비트 > 마이페이지 > Open API 관리에서 발급합니다.
# 권한은 "자산조회"와 "주문하기"만 체크하세요("주문조회"가 따로 있으면 함께 체크). 출금 권한은 절대 체크하지 마세요.
# 허용 IP에는 본인 PC의 공인 IP만 등록하세요.
UPBIT_ACCESS_KEY=여기에_액세스키
UPBIT_SECRET_KEY=여기에_시크릿키

# --- 서버 포트 ---
# 브라우저 주소 http://127.0.0.1:포트/ 의 숫자입니다. "이미 사용 중" 오류가 나면 8788 등으로 바꾸세요.
PORT=8787

# --- 안전 모드 ---
# true: 업비트로 실제 주문을 보내지 않고 "보냈을 요청 내용"만 보여 줍니다(처음엔 꼭 true로 시험).
# false: 실제 주문이 나갑니다. 충분히 시험한 뒤 본인 판단으로만 바꾸세요.
DRY_RUN=true

# --- 서버가 마지막으로 막는 한도 (화면 설정과 별개) ---
# 1회 최대 매수 금액(원)
MAX_ORDER_KRW=50000
# 하루 최대 "매수" 횟수(한국시간 자정에 초기화, 서버를 다시 켜도 초기화)
# 매도(청산)는 이 한도와 상관없이 항상 허용합니다. 업비트가 거부한 주문은 횟수에 세지 않습니다.
# (이름은 DAILY_MAX_ORDERS 그대로 씁니다)
DAILY_MAX_ORDERS=10
# 주문을 허용할 마켓(쉼표로 구분). 예: KRW-BTC,KRW-ETH
ALLOWED_MARKETS=KRW-BTC

# --- 로컬 토큰 ---
# 브라우저가 이 서버에 접속할 때 쓰는 비밀번호입니다. 비워 두면 처음 실행할 때 자동으로 만들어 여기에 저장합니다.
LOCAL_TOKEN=

# --- (고급) 외부 웹 페이지에서 접속 허용 ---
# 비워 두면 꺼짐(권장). 서버가 직접 보여 주는 http://127.0.0.1:포트/ 화면만 실거래를 쓸 수 있습니다.
# 자신이 운영하는 https 사이트에서 접속하게 하려면 그 출처를 적습니다. 예: https://example.github.io
ALLOWED_PAGES_ORIGIN=
