# 업비트 Open API 키 (자산조회·주문조회·주문하기 권한만. 출금 권한은 절대 체크하지 마세요)
UPBIT_ACCESS_KEY=여기에_액세스키
UPBIT_SECRET_KEY=여기에_시크릿키
PORT=8787
# true면 업비트로 주문을 보내지 않고 서명된 요청 내용만 응답(기본 true, 첫 실행 안전장치)
DRY_RUN=true
# 서버 측 하드 한도 (브라우저 설정과 별개로 서버가 최종 차단)
MAX_ORDER_KRW=50000
DAILY_MAX_ORDERS=20
ALLOWED_MARKETS=KRW-BTC,KRW-ETH
# 비우면 시작할 때마다 무작위 토큰 생성
LOCAL_TOKEN=
# GitHub Pages 출처 허용 여부 (결정 D1, 기본 false)
ALLOW_PAGES_ORIGIN=false
